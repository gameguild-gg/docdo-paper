# docdo pipeline configuration (copy to .env and fill in secrets)
# Model tiers: all four pinned to the mini tier for the v2 coverage run
# (paper-coverage-gap-update Task 1). Defaults in operations/src/docdo/config.py match.
DOCDO_MODEL=gpt-4o-mini
DOCDO_BATCH_MODEL=gpt-4o-mini
DOCDO_FULLTEXT_MODEL=gpt-4o-mini
DOCDO_TIEBREAKER_MODEL=gpt-4o-mini

# Required at runtime for any OpenAI-backed stage
OPENAI_API_KEY=
